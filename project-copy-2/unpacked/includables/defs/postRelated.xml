<b:includable xmlns="http://www.w3.org/1999/xhtml" xmlns:b="http://www.google.com/2005/gml/b" xmlns:data="http://www.google.com/2005/gml/data" xmlns:expr="http://www.google.com/2005/gml/expr" id="postRelated" var="post">
              <!-- Related Posts -->
                <div id="related-wrap">
                  <div class="title-wrap">
                    <h3><data:messages.youMayLikeThesePosts /></h3>
                  </div>
                  <div class="related-ready">
                    <b:if cond="data:post.labels">
                      <div class="related-tag" expr:data-label="data:post.labels.first.name" />
                      <b:else />
                      <div class="related-tag" data-label="random" />
                    </b:if>
                  </div> 
                </div>  
            </b:includable>
            
