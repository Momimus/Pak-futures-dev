<b:includable xmlns="http://www.w3.org/1999/xhtml" xmlns:b="http://www.google.com/2005/gml/b" xmlns:data="http://www.google.com/2005/gml/data" xmlns:expr="http://www.google.com/2005/gml/expr" id="cloud">
            <b:if cond="data:view.isHomepage">
              <a class="label_name selected" href="/">
                <b:switch var="data:blog.locale">
                  <b:case value="id" />Terbaru
                  <b:default />Latest
                </b:switch>
              </a>
              <b:else />
              <a class="label_name" href="/">
                <b:switch var="data:blog.locale">
                  <b:case value="id" />Terbaru
                  <b:default />Latest
                </b:switch>
              </a>
            </b:if>
            <b:loop values="data:labels" var="label">
              <b:if cond="data:blog.url==data:label.url">
                <a class="label_name selected" expr:href="data:label.url">
                  <data:label.name />
                  <b:if cond="data:this.showFreqNumbers">
                    <span class="label_count">
                      <data:label.count />
                    </span>
                  </b:if>
                </a>
                <b:else />
                <a class="label_name" expr:href="data:label.url">
                  <data:label.name />
                  <b:if cond="data:this.showFreqNumbers">
                    <span class="label_count">
                      <data:label.count />
                    </span>
                  </b:if>
                </a>
              </b:if>
            </b:loop>
          </b:includable>
            
