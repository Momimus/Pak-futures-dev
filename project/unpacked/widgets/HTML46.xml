&lt;style&gt;
    #sub-cat-list {
        display: flex;
        flex-wrap: wrap;
        justify-content: center;
        gap: 10px;
    }

    #sub-cat-list .widget.Image {
        width: calc(16.5% - 20px);
        display: flex;
        flex-flow: column;
        justify-content: center;
        align-items: center;
        padding: 15px;
        box-sizing: border-box;
    }

    #sub-cat-list .serv-tile-box-link {
        display: flex;
        flex-flow: column;
        justify-content: center;
        align-items: center;
    }

    #sub-cat-list .serv-tile-box-avatar {
        flex-shrink: 1;
    }

    #sub-cat-list .serv-tile-box-info {
        flex-grow: 1;
        overflow: hidden;
    }

    #sub-cat-list .serv-tile-box-title {
        font-size: 1rem;
        line-height: 1.2;
    }

    /* Responsive: Laptop Small */
    @media (max-width: 1366px) {
        #sub-cat-list .widget.Image {
            width: calc(25% - 20px);
        }
    }

    /* Responsive: Tablet */
    @media (max-width: 700px) {

        #sub-cat-list {
            gap: 5px;
        }

        #sub-cat-list .widget.Image {
            width: calc(33.33% - 15px);
            padding: 7.5px;
        }

        #sub-cat-list .serv-tile-box-title {
            font-size: 0.7rem!important;
            line-height: 1.2;
            margin-top: 0.5rem!important;
            display: inline-block;
        }

    }


    /* Responsive: Laptop Small */
    @media (max-width: 300px) {
        #sub-cat-list .widget.Image {
            width: calc(50% - 15px);
        }
    }

