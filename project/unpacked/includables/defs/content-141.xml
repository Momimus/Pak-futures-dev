<b:includable xmlns="http://www.w3.org/1999/xhtml" xmlns:b="http://www.google.com/2005/gml/b" xmlns:expr="http://www.google.com/2005/gml/expr" id="content">
      <div class="widget-content" role="search">
        <div class="hero-header-search">
          <form class="search-form" expr:action="data:blog.searchUrl" role="search">
            <b:attr cond="not data:view.isPreview" name="target" value="_top" />
            <b:include name="urlParamsAsFormInput" />
            <input autocomplete="off" class="search-input" expr:placeholder="&quot;Find best opportunity&quot;" name="q" type="search" value="" />
            <button aria-label="Search" id="search-submit" type="submit" value="">
              <i aria-hidden="true" class="fa-solid fa-magnifying-glass" />
            </button>
          </form>
        </div>
      </div>
    </b:includable>
             
