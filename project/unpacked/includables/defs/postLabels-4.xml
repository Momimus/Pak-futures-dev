<b:includable xmlns="http://www.w3.org/1999/xhtml" xmlns:b="http://www.google.com/2005/gml/b" xmlns:data="http://www.google.com/2005/gml/data" xmlns:expr="http://www.google.com/2005/gml/expr" id="postLabels">
  <span class="byline post-labels">
    <span class="byline-label"><data:byline.label /></span>
    <b:loop index="i" values="data:post.labels" var="label">
      <a expr:href="data:label.url" rel="tag">
        <data:label.name />
      </a>
    </b:loop>
  </span>
</b:includable>
            
