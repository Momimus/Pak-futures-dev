<b:includable xmlns="http://www.w3.org/1999/xhtml" xmlns:b="http://www.google.com/2005/gml/b" xmlns:data="http://www.google.com/2005/gml/data" xmlns:expr="http://www.google.com/2005/gml/expr" id="postTitle" var="post">
              <!-- Post Title Index and Item -->
              <b:if cond="data:view.isMultipleItems">
                <h2 class="post-title">
                  <a expr:href="data:post.url"><data:post.title /></a>
                </h2>
              </b:if>
              <b:if cond="data:view.isSingleItem">
                <h1 class="post-title">
                  <data:post.title />
                </h1>
              </b:if>
            </b:includable>
            
