<b:includable xmlns="http://www.w3.org/1999/xhtml" xmlns:b="http://www.google.com/2005/gml/b" xmlns:expr="http://www.google.com/2005/gml/expr" id="indexPost" var="post">
  <div class="index-post-inside-wrap" expr:data-post-url="data:post.url">
    <!-- Index Post Content -->
    <b:include data="post" name="postFeaturedImage" />
    <div class="post-info-wrap">
      <div class="post-info">           
        <b:include data="post" name="postCategory" />
        <b:include data="post" name="postHeader" />
      </div>
      <div class="index-post-footer">
        <b:include data="post" name="headerByline" />
        <b:include data="post" name="postSummary" />
        <b:include data="post" name="postJumpLink" />
      </div>
    </div>
  </div>
</b:includable>
            
