<b:includable xmlns="http://www.w3.org/1999/xhtml" xmlns:b="http://www.google.com/2005/gml/b" xmlns:data="http://www.google.com/2005/gml/data" xmlns:expr="http://www.google.com/2005/gml/expr" id="servTileCard">
              <div class="serv-tile-box-avatar">
                <b:if cond="data:sourceUrl">
                  <img expr:alt="data:title" expr:src="data:sourceUrl" />
                  <b:else />
                  <i class="fa fi fi-tr-briefcase" />
                </b:if>
              </div>
              <div class="serv-tile-box-info">
                <h3 class="serv-tile-box-title"><data:title /></h3>
                <b:if cond="data:caption">
                  <p class="serv-tile-box-meta"><data:caption /></p>
                </b:if>
              </div>
            </b:includable>
          
